  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DebuggerFlavor>LaunchJsonDebugger</DebuggerFlavor>
    <LaunchJsonTarget>{
  "name": "Debug Angular Tests (Karma)",
  "type": "chrome",
  "request": "launch",
  "url": "http://localhost:9876/debug.html",
  "userDataDir": "C:\\Users\\jasta\\source\\repos\\VetFlow\\vetflow.client/.vscode/chrome-debug-user-data",
  "webRoot": "C:\\Users\\jasta\\source\\repos\\VetFlow\\vetflow.client",
  "preLaunchTask": "run-karma-debug",
  "sourceMaps": true,
  "timeout": 120000,
  "sourceMapPathOverrides": {
    "webpack:///*": "${webRoot}/*",
    "webpack:///./*": "${webRoot}/*",
    "webpack:///src/*": "${webRoot}/src/*"
  }
}</LaunchJsonTarget>
  </PropertyGroup>
